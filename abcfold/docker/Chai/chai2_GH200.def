Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu24.04

%post
    mkdir -p /host/nccl

    # Install system packages
    DEBIAN_FRONTEND=noninteractive \
    apt-get update --quiet \
    && apt-get install --yes --quiet --allow-change-held-packages \
        python3.12 python3-pip python3.12-venv python3.12-dev \
        git wget gcc g++ make zlib1g-dev \
        libnccl2 libnccl-dev \
        kalign numactl

    # Create Python virtual environment
    python3 -m venv /chai_venv
    /chai_venv/bin/pip3 install --no-cache-dir --upgrade pip setuptools wheel

    # Install PyTorch for ARM with CUDA 12
    /chai_venv/bin/pip3 install --no-cache-dir \
        torch==2.4.0 \
        --index-url https://download.pytorch.org/whl/cu124

    # Install JAX 0.4.30 with CUDA 12 support
    /chai_venv/bin/pip3 install --no-cache-dir \
        jax[cuda12]==0.4.30 \
        -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

    # Install Chai-1 and dependencies
    /chai_venv/bin/pip3 install --no-cache-dir \
        chai_lab==0.6.1 \
        antipickle typer jaxtyping beartype pandera matplotlib

    # --- FIX: Get correct Python site-packages path ---
    SITE_PACKAGES=$(/chai_venv/bin/python3 -c "import site; print(site.getsitepackages()[0])")
    echo "Site packages path: ${SITE_PACKAGES}"

    # Create downloads directory in correct location
    mkdir -p "${SITE_PACKAGES}/downloads"
    cd "${SITE_PACKAGES}/downloads"

    # Download conformer cache
    echo "Downloading conformers cache..."
    wget --tries=3 --timeout=60 --continue \
        https://chaiassets.com/chai1-inference-depencencies/conformers_v1.apkl \
        || echo "Warning: conformers download failed"

    # NOTE: leaving_atoms_v1.apkl returns 404, skip it
    # It will be generated at runtime if needed

    # Download ESM model
    echo "Downloading ESM model..."
    mkdir -p "${SITE_PACKAGES}/downloads/esm"
    wget --tries=3 --timeout=120 --continue \
        -P "${SITE_PACKAGES}/downloads/esm" \
        https://chaiassets.com/chai1-inference-depencencies/esm2/traced_sdpa_esm2_t36_3B_UR50D_fp16.pt \
        || echo "Warning: ESM model download failed"

    # Download Chai-1 model components
    echo "Downloading Chai-1 model components..."
    mkdir -p "${SITE_PACKAGES}/downloads/models_v2"
    cd "${SITE_PACKAGES}/downloads/models_v2"

    for component in feature_embedding.pt bond_loss_input_proj.pt \
                     token_embedder.pt trunk.pt \
                     diffusion_module.pt confidence_head.pt; do
        echo "Downloading ${component}..."
        wget --tries=3 --timeout=120 --continue \
            "https://chaiassets.com/chai1-inference-depencencies/models_v2/${component}" \
            || echo "Warning: ${component} download failed"
    done

    # Set permissions to ensure files are readable
    chmod -R 755 "${SITE_PACKAGES}/downloads"

    # Verify downloads
    echo "Verifying downloads..."
    ls -lh "${SITE_PACKAGES}/downloads/"
    ls -lh "${SITE_PACKAGES}/downloads/models_v2/"

    # Cleanup
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH="/chai_venv/bin:$PATH"

    # GH200 Hopper optimizations
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export XLA_CLIENT_MEM_FRACTION=0.90
    export TF_GPU_THREAD_MODE=gpu_private
    export TF_GPU_THREAD_COUNT=8

    # NCCL for Grace-Hopper NVLink-C2C
    export NCCL_NVLS_ENABLE=1
    export NCCL_NET_GDR_LEVEL=5
    export CUDA_DEVICE_ORDER=PCI_BUS_ID

%runscript
    exec /chai_venv/bin/python3 -m chai_lab.chai1 "$@"

%labels
    Author Chai_Team
    Version 0.6.1_GH200
    Architecture arm64
